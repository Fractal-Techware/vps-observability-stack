# The Prometheus UI, protected by HTTP basic auth (bcrypt hash generated by setup.sh into
# secrets/caddy_admin_users). Grafana has its own login and is not listed here.

# Never expose the TSDB admin API (snapshots, deletes).
handle /prometheus/api/v1/admin/* {
	respond "Forbidden" 403
}

handle /prometheus* {
	basic_auth {
		import /run/secrets/caddy_admin_users
	}
	reverse_proxy prometheus:9090
}

# Grafana's own /metrics endpoint is for the internal Prometheus only.
handle /metrics {
	respond "Not Found" 404
}
