# FTW Single-VPS Observability Stack (free edition) - settings.
# Copy to .env (setup.sh does it for you). Secrets do NOT go here: they live in secrets/
# and are generated by setup.sh. There are no default passwords anywhere in this repo.

# ---- Required -------------------------------------------------------------------------
# Host name with a DNS A/AAAA record pointing at this server.
DOMAIN=monitoring.example.com
# E-mail address for automatic Let's Encrypt certificates, or `internal` for Caddy's local CA
# (self-signed; for tests and private networks only).
CADDY_TLS=you@example.com

# ---- Compose ----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=ftwvps
COMPOSE_FILE=compose.yaml

# ---- Network ----------------------------------------------------------------------------
# Only Caddy publishes ports. Use 127.0.0.1 to test locally without exposing anything.
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# ---- Identity ---------------------------------------------------------------------------
# `instance` label for this VPS in the dashboard and alerts (setup.sh fills in `hostname`).
STACK_HOSTNAME=
GRAFANA_ADMIN_USER=admin
# Basic-auth user for /prometheus/ (password: secrets/admin_ui_password).
ADMIN_UI_USER=admin

# ---- Retention & sizing -----------------------------------------------------------------
# Whichever limit is hit first wins.
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=10GB
PROMETHEUS_MEMORY_LIMIT=1G
GRAFANA_MEMORY_LIMIT=512M
