# FTW Single-VPS Observability Stack - Caddy reverse proxy.
# DOMAIN and CADDY_TLS come from .env (see setup.sh). CADDY_TLS is either an e-mail address
# (automatic Let's Encrypt / ZeroSSL certificates) or `internal` (Caddy's local CA, for tests
# and private networks). Caddy listens on 8080/8443 inside the container so it can run as a
# non-root user; compose maps them to 80/443 on the host.
{
	http_port 8080
	https_port 8443
	# Redirects are declared explicitly below so they never point at the internal 8443 port.
	auto_https disable_redirects
	servers {
		metrics
	}
}

# Internal metrics endpoint (scraped by Prometheus, used by the healthcheck). Not published.
:9180 {
	metrics /metrics
}

http://{$DOMAIN} {
	redir https://{host}{uri} permanent
}

{$DOMAIN} {
	tls {$CADDY_TLS}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Per-tier routes: Prometheus/Alertmanager UIs (all tiers), remote ingest (Pro+).
	import /etc/caddy/routes.d/*.caddy

	# Everything else is Grafana (it has its own login).
	handle {
		reverse_proxy grafana:3000
	}

	log {
		output stdout
		format json
	}
}
